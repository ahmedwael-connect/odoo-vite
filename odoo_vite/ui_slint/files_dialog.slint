// Backup files dialog (PSS-4): dumps for one instance with Restore +
// Delete. Single-select shared list; the driver resolves the picked id.
import { Button } from "std-widgets.slint";
import { Row, SelectionList } from "selection_list.slint";

export component FilesDialog inherits Dialog {
    title: "Backup files";

    in-out property<[Row]> rows;
    in-out property<string> counts-text: "";

    callback picked(string);
    callback restore-requested();
    callback delete-requested();
    callback cancelled();

    VerticalLayout {
        SelectionList {
            is-multi: false;
            show-filter: true;
            rows: rows;
            counts-text: counts-text;
            row-picked(id) => { picked(id); }
        }
        HorizontalLayout {
            Button {
                text: "Cancel";
                clicked => { cancelled(); }
            }
            Button {
                text: "Delete";
                clicked => { delete-requested(); }
            }
            Button {
                text: "Restore";
                primary: true;
                clicked => { restore-requested(); }
            }
        }
    }
}
