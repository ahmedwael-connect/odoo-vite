// Schedule dialog (PSS-4): databases checklist + cron presets + retention.
// Choosing a preset fills the expression; typing a custom expression flips
// the preset picker back to "Custom…" (the Qt clobber-bug fix, kept).
import { Button, ComboBox, LineEdit, SpinBox } from "std-widgets.slint";
import { Row, SelectionList } from "selection_list.slint";

export component ScheduleDialog inherits Dialog {
    title: "Scheduled backups";

    in-out property<[Row]> db-rows;
    in-out property<string> db-counts: "";
    in-out property<[string]> presets;
    in-out property<int> preset-idx: 0;
    in-out property<string> cron: "0 2 * * *";
    in-out property<int> retention-n: 7;
    in-out property<int> retention-days: 0;
    in-out property<bool> is-edit: false;

    callback db-toggled(string);
    callback preset-chosen(int);
    callback cron-edited(string);
    callback save-requested();
    callback cancelled();

    VerticalLayout {
        Text { text: "Databases to back up:"; }
        SelectionList {
            is-multi: true;
            show-filter: false;
            rows: db-rows;
            counts-text: db-counts;
            row-toggled(id) => { db-toggled(id); }
        }
        HorizontalLayout {
            Text { text: "Schedule:"; }
            ComboBox {
                model: presets;
                current-index <=> preset-idx;
                selected => { preset-chosen(self.current-index); }
            }
            LineEdit {
                text <=> cron;
                edited(text) => { cron-edited(text); }
            }
        }
        HorizontalLayout {
            Text { text: "Keep last:"; }
            SpinBox {
                minimum: 1;
                maximum: 365;
                value <=> retention-n;
            }
            Text { text: "Keep days (0 = off):"; }
            SpinBox {
                minimum: 0;
                maximum: 3650;
                value <=> retention-days;
            }
        }
        Text {
            text: "Runs even when Odoo Vite is closed (systemd timer). Dumps use pg_dump -Fc. Retention prunes older files.";
            wrap: word-wrap;
            color: gray;
        }
        HorizontalLayout {
            Button {
                text: "Cancel";
                clicked => { cancelled(); }
            }
            Button {
                text: is-edit ? "Save changes" : "Save schedule";
                primary: true;
                clicked => { save-requested(); }
            }
        }
    }
}
