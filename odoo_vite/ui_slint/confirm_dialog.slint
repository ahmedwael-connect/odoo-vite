// Light confirm tier (PSS-2): Qt ask_confirm parity.
import { Button } from "std-widgets.slint";

export component ConfirmDialog inherits Dialog {
    title: "Confirm";

    in-out property<string> heading: "";
    in-out property<string> body: "";
    in-out property<string> confirm-label: "Confirm";
    // UXS-2 destructive convention: std Button has no destructive role,
    // so the heading carries it (Qt role=destructive parity). Two Texts
    // keep the normal branch on the theme color (dark-mode safe).
    in-out property<bool> destructive: false;

    callback confirmed();
    callback cancelled();

    VerticalLayout {
        if !destructive: Text {
            text: heading;
            font-size: 18px;
            font-weight: 700;
        }
        if destructive: Text {
            text: "⚠ " + heading;
            font-size: 18px;
            font-weight: 700;
            color: red;
        }
        Text {
            text: body;
            wrap: word-wrap;
        }
        HorizontalLayout {
            Button {
                text: "Cancel";
                clicked => { cancelled(); }
            }
            Button {
                text: confirm-label;
                primary: true;
                clicked => { confirmed(); }
            }
        }
    }
}
