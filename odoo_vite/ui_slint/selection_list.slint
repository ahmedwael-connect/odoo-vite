// SelectionList view (PSS-2): renders SelectionState rows + filter + counts.
//
// One component per file (Slint-Python beta generates code for a single
// non-Window component per file). State lives in ui_slint/selection.py;
// toggles/picks/filter come back through callbacks, Python pushes rows.
import { Button, CheckBox, LineEdit, ListView } from "std-widgets.slint";

export struct Row {
    id: string,
    title: string,
    badge: string,
    checked: bool,
    header: bool,
}

export component SelectionList inherits VerticalLayout {
    in-out property<[Row]> rows;
    in-out property<bool> is-multi: true;
    in-out property<bool> show-filter: true;
    in-out property<string> filter-text: "";
    in-out property<string> counts-text: "";
    // Highlighted row id (single-select lists drive it from picked).
    in-out property<string> selected-id: "";

    callback row-toggled(string);
    callback row-picked(string);
    callback filter-changed(string);

    LineEdit {
        visible: show-filter;
        placeholder-text: "Filter…";
        text <=> filter-text;
        edited(text) => { filter-changed(text); }
    }
    ListView {
        for row in rows: HorizontalLayout {
            if row.header: Text {
                text: row.title;
                font-weight: 700;
            }
            // The TouchArea wraps the row content so it fills the row:
            // a bare TouchArea inside a layout is zero-size and never
            // fires (every picker since PSS-2 was unclickable because of
            // this — clicks landed on the Text, which has no handler).
            if !row.header: TouchArea {
                mouse-cursor: pointer;
                clicked => { row-picked(row.id); }
                HorizontalLayout {
                    CheckBox {
                        visible: is-multi;
                        checked: row.checked;
                        toggled => { row-toggled(row.id); }
                    }
                    Text {
                        horizontal-stretch: 1;
                        overflow: elide;
                        text: row.title;
                        font-weight: row.id == selected-id ? 700 : row.checked && is-multi ? 700 : 400;
                    }
                    if row.badge != "": Text {
                        text: row.badge;
                        color: gray;
                    }
                }
            }
        }
    }
    Text {
        visible: counts-text != "";
        text: counts-text;
        color: gray;
    }
}
