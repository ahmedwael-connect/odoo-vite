// Adopt Instance wizard (PSS-7b): locate → gaps → adopt run. Nothing
// is written until Adopt. Gap rows are dynamic (missing fields editable);
// LineEdits own text one-way and report through gap-edited.
import { Button, LineEdit, ListView } from "std-widgets.slint";

export struct GapRow {
    key: string,
    caption: string,
    status: string,
    missing: bool,
    value: string,
}

export component AdoptDialog inherits Dialog {
    title: "Adopt Instance";

    in-out property<int> page-idx: 0;
    in-out property<string> loc-name: "";
    in-out property<string> loc-conf: "";
    in-out property<string> loc-community: "";
    in-out property<string> loc-detected: "";
    in-out property<string> loc-err: "";
    in-out property<[GapRow]> gap-rows;
    in-out property<string> gap-db: "";
    in-out property<string> gap-err: "";
    in-out property<string> run-status: "";
    in-out property<bool> run-done: false;

    callback locate-changed();
    callback browse-conf();
    callback browse-community();
    callback gap-edited(string, string);
    callback wiz-nav(string);

    VerticalLayout {
        Text {
            text: "Locate existing install — point at an odoo.conf and its community folder.";
            font-size: 16px;
            font-weight: 700;
            visible: page-idx == 0;
            wrap: word-wrap;
        }
        VerticalLayout {
            visible: page-idx == 0;
            HorizontalLayout {
                Text { text: "Instance name:"; width: 150px; }
                LineEdit {
                    placeholder-text: "e.g. Legacy Prod Clone";
                    text <=> loc-name;
                    edited(text) => { locate-changed(); }
                }
            }
            HorizontalLayout {
                Text { text: "odoo.conf:"; width: 150px; }
                LineEdit {
                    placeholder-text: "path to odoo.conf";
                    text <=> loc-conf;
                    edited(text) => { locate-changed(); }
                }
                Button {
                    text: "Browse…";
                    clicked => { browse-conf(); }
                }
            }
            HorizontalLayout {
                Text { text: "Community folder:"; width: 150px; }
                LineEdit {
                    placeholder-text: "path to community folder";
                    text <=> loc-community;
                    edited(text) => { locate-changed(); }
                }
                Button {
                    text: "Browse…";
                    clicked => { browse-community(); }
                }
            }
            Text {
                text: loc-detected;
                color: gray;
                wrap: word-wrap;
            }
            Text {
                visible: loc-err != "";
                text: loc-err;
                color: red;
            }
        }
        Text {
            text: "Fill the gaps — missing fields are editable, nothing is invented.";
            font-size: 16px;
            font-weight: 700;
            visible: page-idx == 1;
            wrap: word-wrap;
        }
        ListView {
            visible: page-idx == 1;
            for g in gap-rows: VerticalLayout {
                Text {
                    text: g.caption + ": " + g.status;
                    color: g.missing ? orange : gray;
                }
                LineEdit {
                    visible: g.missing;
                    text: g.value;
                    edited(t) => { gap-edited(g.key, t); }
                }
            }
        }
        HorizontalLayout {
            visible: page-idx == 1;
            Text { text: "Primary database:"; width: 150px; }
            LineEdit {
                text <=> gap-db;
            }
        }
        Text {
            visible: page-idx == 1 && gap-err != "";
            text: gap-err;
            color: red;
        }
        Text {
            text: "Adopting";
            font-size: 16px;
            font-weight: 700;
            visible: page-idx == 2;
        }
        Text {
            visible: page-idx == 2;
            text: run-status;
            color: gray;
            wrap: word-wrap;
        }
        Button {
            visible: page-idx == 2 && run-done;
            text: "Close";
            primary: true;
            clicked => { wiz-nav("close"); }
        }
        HorizontalLayout {
            Button {
                text: "Back";
                enabled: page-idx > 0 && !(page-idx == 2 && !run-done);
                clicked => { wiz-nav("back"); }
            }
            Button {
                text: "Cancel";
                clicked => { wiz-nav("cancel"); }
            }
            Button {
                visible: page-idx < 2;
                text: "Next";
                primary: true;
                clicked => { wiz-nav("next"); }
            }
        }
    }
}
