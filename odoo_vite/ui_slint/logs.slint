// Logs view (PSS-6a, cards MX-2): tail with Follow toggle + Clear,
// regex search, doctor findings, slow queries, profiler trigger. Tail
// polling lives in the bridge (1s UI-thread Timer, gated on this tab
// being visible); heavy work dispatches grouped actions. The tail stays
// uncarded (it stretches); bounded sections are cards.
import { Button, CheckBox, ComboBox, GroupBox, LineEdit, ListView } from "std-widgets.slint";

export component LogsView inherits VerticalLayout {
    in-out property<bool> has-instance: false;
    in-out property<bool> log-follow: true;
    in-out property<string> log-note: "";
    in-out property<string> log-search: "";
    in-out property<[string]> log-levels;
    in-out property<int> log-level-idx: 0;
    in-out property<string> log-search-status: "";
    in-out property<[string]> log-search-lines;
    in-out property<[string]> log-doctor-lines;
    in-out property<bool> log-doctor-visible: false;
    in-out property<[string]> log-tail-lines;
    in-out property<string> log-slow-status: "";
    in-out property<[string]> log-slow-lines;
    in-out property<[string]> log-profile-durs;
    in-out property<int> log-profile-idx: 1;

    // NOTE Slint 1.18: callback args are type-only, no names.
    callback log-action(string);

    HorizontalLayout {
        CheckBox {
            text: "Follow";
            checked <=> log-follow;
        }
        Button {
            text: "Clear view";
            enabled: has-instance;
            clicked => { log-action("clear"); }
        }
        Button {
            text: "Run Doctor";
            enabled: has-instance;
            clicked => { log-action("doctor"); }
        }
    }
    HorizontalLayout {
        ComboBox {
            model: log-profile-durs;
            current-index <=> log-profile-idx;
        }
        Button {
            text: "Profile";
            enabled: has-instance;
            clicked => { log-action("profile"); }
        }
    }
    Text {
        visible: has-instance && !log-follow;
        text: "⏸ not following — toggle Follow to resume";
        color: orange;
    }
    Text {
        text: log-note;
        color: gray;
        wrap: word-wrap;
    }
    GroupBox {
        title: "Search (full file)";
        VerticalLayout {
            HorizontalLayout {
                LineEdit {
                    placeholder-text: "regex pattern…";
                    text <=> log-search;
                }
                ComboBox {
                    model: log-levels;
                    current-index <=> log-level-idx;
                }
                Button {
                    text: "Search";
                    enabled: has-instance;
                    clicked => { log-action("search"); }
                }
            }
            Text {
                text: log-search-status;
                color: gray;
            }
            ListView {
                max-height: 170px;
                for line in log-search-lines: Text {
                    overflow: elide;
                    text: line;
                }
            }
            ListView {
                visible: log-doctor-visible;
                max-height: 170px;
                for line in log-doctor-lines: Text {
                    overflow: elide;
                    text: line;
                }
            }
        }
    }
    ListView {
        vertical-stretch: 1;
        for line in log-tail-lines: Text {
            overflow: elide;
            text: line;
        }
    }
    GroupBox {
        title: "Slow queries (pg_stat_statements)";
        VerticalLayout {
            HorizontalLayout {
                Text {
                    text: log-slow-status;
                    color: gray;
                }
                Button {
                    text: "Refresh";
                    enabled: has-instance;
                    clicked => { log-action("slow-refresh"); }
                }
            }
            ListView {
                max-height: 150px;
                for line in log-slow-lines: Text {
                    overflow: elide;
                    text: line;
                }
            }
        }
    }
}
