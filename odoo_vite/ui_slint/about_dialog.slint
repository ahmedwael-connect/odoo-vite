// About dialog (PSS-9): Slint royalty-free license disclosure.
// Required by LicenseRef-Slint-Royalty-free: the disclosure widget must
// be shown in the app. Opened from the sidebar About button.
import { AboutSlint, Button } from "std-widgets.slint";

export component AboutDialog inherits Dialog {
    title: "About";

    in-out property<string> app-version: "";

    callback cancelled();

    VerticalLayout {
        Text {
            text: "Odoo Vite " + app-version + " — local Odoo instance manager";
            font-size: 16px;
            font-weight: 700;
            wrap: word-wrap;
        }
        AboutSlint {
        }
        HorizontalLayout {
            Button {
                text: "Close";
                primary: true;
                clicked => { cancelled(); }
            }
        }
    }
}
