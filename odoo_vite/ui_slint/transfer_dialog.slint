// Import dialog (PSS-8): bundle preview summary + new name/port.
// Scope honesty (Qt parity): files + settings only — databases travel
// via Backup/Restore, the venv rebuilds before first start.
import { Button, LineEdit, SpinBox } from "std-widgets.slint";

export component TransferDialog inherits Dialog {
    title: "Import instance";

    in-out property<string> bundle-name: "";
    in-out property<string> bundle-version: "";
    in-out property<string> new-name: "";
    in-out property<int> new-port: 8070;

    callback import-requested();
    callback cancelled();

    VerticalLayout {
        Text {
            text: "Import '" + bundle-name + "' (Odoo " + bundle-version + ")";
            font-size: 16px;
            font-weight: 700;
            wrap: word-wrap;
        }
        HorizontalLayout {
            Text { text: "Name:"; width: 110px; }
            LineEdit { text <=> new-name; }
        }
        HorizontalLayout {
            Text { text: "Port:"; width: 110px; }
            SpinBox {
                minimum: 1024;
                maximum: 65535;
                value <=> new-port;
            }
        }
        Text {
            text: "Copies files + settings only — databases are NOT copied, and the venv is rebuilt before first start.";
            color: gray;
            wrap: word-wrap;
        }
        HorizontalLayout {
            Button {
                text: "Cancel";
                clicked => { cancelled(); }
            }
            Button {
                text: "Import";
                primary: true;
                clicked => { import-requested(); }
            }
        }
    }
}
