// Addon Path Manager (PSS-5b): ordered paths with enable toggles.
// Order matters (first match wins in Odoo); unchecked paths stay listed
// but are excluded from addons_path. Up/Down reorder, Rename edits the
// picked path in place, Browse fills the add row (typing works too).
import { Button, LineEdit } from "std-widgets.slint";
import { Row, SelectionList } from "selection_list.slint";

export component AddonsDialog inherits Dialog {
    title: "Addon paths";

    in-out property<[Row]> rows;
    in-out property<string> counts-text: "";
    in-out property<string> selected-id: "";
    in-out property<string> edit-path: "";
    in-out property<string> add-path: "";

    callback toggled(string);
    callback picked(string);
    callback rename-requested();
    callback up-requested();
    callback down-requested();
    callback remove-requested();
    callback browse-requested();
    callback add-requested();
    callback apply-requested();
    callback cancelled();

    VerticalLayout {
        Text {
            text: "Order matters (first match wins in Odoo). Unchecked paths stay listed but are excluded from addons_path.";
            wrap: word-wrap;
        }
        SelectionList {
            is-multi: true;
            show-filter: false;
            rows: rows;
            counts-text: counts-text;
            selected-id: selected-id;
            row-toggled(id) => { toggled(id); }
            row-picked(id) => { picked(id); }
        }
        HorizontalLayout {
            LineEdit {
                text <=> edit-path;
            }
            Button {
                text: "Rename";
                clicked => { rename-requested(); }
            }
        }
        HorizontalLayout {
            Button {
                text: "Up";
                clicked => { up-requested(); }
            }
            Button {
                text: "Down";
                clicked => { down-requested(); }
            }
            Button {
                text: "Remove";
                clicked => { remove-requested(); }
            }
        }
        HorizontalLayout {
            LineEdit {
                placeholder-text: "New addons folder…";
                text <=> add-path;
            }
            Button {
                text: "Browse…";
                clicked => { browse-requested(); }
            }
            Button {
                text: "Add";
                clicked => { add-requested(); }
            }
        }
        HorizontalLayout {
            Button {
                text: "Cancel";
                clicked => { cancelled(); }
            }
            Button {
                text: "Apply changes";
                primary: true;
                clicked => { apply-requested(); }
            }
        }
    }
}
