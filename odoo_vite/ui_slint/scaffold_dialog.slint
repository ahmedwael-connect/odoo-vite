// Scaffold Module wizard (PSS-7c): definition → generate + install.
// Acceptance rule: a module isn't done until it installs cleanly, so
// the build page runs generate-then-install and reports the install
// result. Field lines are one per line (name:type) in a TextEdit.
import { Button, ComboBox, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";

export component ScaffoldDialog inherits Dialog {
    title: "New Module";

    in-out property<int> page-idx: 0;
    in-out property<string> scaf-tech: "";
    in-out property<string> scaf-pretty: "";
    in-out property<string> scaf-version: "17.0";
    in-out property<string> scaf-summary: "";
    in-out property<string> scaf-author: "";
    in-out property<string> scaf-model: "";
    in-out property<string> scaf-fields: "";
    in-out property<string> scaf-dest: "";
    in-out property<[string]> scaf-instances;
    in-out property<int> scaf-inst-idx: 0;
    in-out property<string> scaf-db: "";
    in-out property<string> scaf-err: "";
    in-out property<string> build-status: "";
    in-out property<string> build-log: "";
    in-out property<bool> build-running: false;
    in-out property<bool> build-failed: false;
    in-out property<bool> build-done: false;

    callback browse-dest();
    callback wiz-nav(string);

    VerticalLayout {
        Text {
            text: "New module — generates into a custom_addons folder, then installs as acceptance.";
            font-size: 16px;
            font-weight: 700;
            visible: page-idx == 0;
            wrap: word-wrap;
        }
        VerticalLayout {
            visible: page-idx == 0;
            HorizontalLayout {
                Text { text: "Technical name:"; width: 150px; }
                LineEdit {
                    placeholder-text: "my_library (a-z, _)";
                    text <=> scaf-tech;
                }
            }
            HorizontalLayout {
                Text { text: "Pretty name:"; width: 150px; }
                LineEdit { text <=> scaf-pretty; }
            }
            HorizontalLayout {
                Text { text: "Odoo version:"; width: 150px; }
                LineEdit { text <=> scaf-version; }
            }
            HorizontalLayout {
                Text { text: "Summary:"; width: 150px; }
                LineEdit { text <=> scaf-summary; }
            }
            HorizontalLayout {
                Text { text: "Author:"; width: 150px; }
                LineEdit { text <=> scaf-author; }
            }
            HorizontalLayout {
                Text { text: "Model name:"; width: 150px; }
                LineEdit {
                    placeholder-text: "library.book (dotted)";
                    text <=> scaf-model;
                }
            }
            HorizontalLayout {
                Text { text: "Fields:"; width: 150px; }
                TextEdit {
                    placeholder-text: "One field per line:  name:type  (e.g. name:char)";
                    text <=> scaf-fields;
                }
            }
            HorizontalLayout {
                Text { text: "Destination:"; width: 150px; }
                LineEdit { text <=> scaf-dest; }
                Button {
                    text: "Browse…";
                    clicked => { browse-dest(); }
                }
            }
            HorizontalLayout {
                Text { text: "Acceptance:"; width: 150px; }
                ComboBox {
                    model: scaf-instances;
                    current-index <=> scaf-inst-idx;
                }
                LineEdit {
                    placeholder-text: "acceptance database";
                    text <=> scaf-db;
                }
            }
            Text {
                visible: scaf-err != "";
                text: scaf-err;
                color: red;
            }
        }
        Text {
            text: "Generate + install";
            font-size: 16px;
            font-weight: 700;
            visible: page-idx == 1;
        }
        Text {
            visible: page-idx == 1;
            text: build-status;
            color: gray;
            wrap: word-wrap;
        }
        build-scroll := ScrollView {
            visible: page-idx == 1;
            min-height: 200px;
            build-text := Text {
                text: build-log;
                wrap: word-wrap;
            }
            content-y: max(0px, build-text.height - self.visible-height);
        }
        Button {
            visible: page-idx == 1 && build-done;
            text: "Close";
            primary: true;
            clicked => { wiz-nav("close"); }
        }
        HorizontalLayout {
            Button {
                text: "Back";
                enabled: page-idx > 0 && !build-running;
                clicked => { wiz-nav("back"); }
            }
            Button {
                text: "Cancel";
                clicked => { wiz-nav("cancel"); }
            }
            Button {
                visible: page-idx == 0;
                text: "Generate";
                primary: true;
                clicked => { wiz-nav("next"); }
            }
        }
    }
}
