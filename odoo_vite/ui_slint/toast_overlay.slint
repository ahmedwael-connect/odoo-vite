// Toast overlay (PSS-2): bottom-center transient label. Embedded in
// AppWindow in PSS-3; standalone here for headless contract tests.
export component ToastOverlay inherits Rectangle {
    in-out property<string> message: "";
    in-out property<bool> showing: false;

    visible: showing;
    Text {
        text: message;
        color: white;
    }
}
