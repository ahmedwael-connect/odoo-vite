// Clone dialog (PSS-3): name + port with the honest scope note
// (files+settings only — databases travel via Backup/Restore, the venv
// is rebuilt before first start). Qt clone_dialog parity.
import { Button, LineEdit, SpinBox } from "std-widgets.slint";

export component CloneDialog inherits Dialog {
    title: "Clone instance";

    in-out property<string> source-name: "";
    in-out property<string> new-name: "";
    in-out property<int> new-port: 8070;

    // Named validation rule (headless-testable like ok-enabled).
    out property<bool> valid: new-name != "";

    callback confirmed();
    callback cancelled();

    VerticalLayout {
        Text {
            text: "Clone '" + source-name + "'";
            font-size: 18px;
            font-weight: 700;
        }
        HorizontalLayout {
            Text { text: "Name:"; }
            LineEdit {
                placeholder-text: "Clone name";
                text <=> new-name;
            }
        }
        HorizontalLayout {
            Text { text: "Port:"; }
            SpinBox {
                minimum: 1024;
                maximum: 65535;
                value <=> new-port;
            }
        }
        Text {
            text: "Copies files + settings only — databases are NOT copied, and the venv is rebuilt before first start.";
            wrap: word-wrap;
            color: gray;
        }
        HorizontalLayout {
            Button {
                text: "Cancel";
                clicked => { cancelled(); }
            }
            Button {
                text: "Clone";
                primary: true;
                enabled: valid;
                clicked => { confirmed(); }
            }
        }
    }
}
