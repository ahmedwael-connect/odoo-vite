// Dependency viewer (PSS-5a): two single-select shared lists.
// Empty panes show explicit empty states, never blank voids (Qt Part B
// rule, kept). Data comes from core edges (Qt read graph["depends"], which
// core never returns — its panes were always empty).
import { Button } from "std-widgets.slint";
import { Row, SelectionList } from "selection_list.slint";

export component DepsDialog inherits Dialog {
    title: "Dependencies";

    in-out property<string> mod-name: "";
    in-out property<[Row]> depends-rows;
    in-out property<string> depends-counts: "";
    in-out property<[Row]> required-rows;
    in-out property<string> required-counts: "";

    callback cancelled();

    VerticalLayout {
        Text {
            text: "Dependencies — " + mod-name;
            font-size: 16px;
            font-weight: 700;
        }
        Text {
            text: "Depends on";
            font-weight: 700;
        }
        SelectionList {
            is-multi: false;
            show-filter: false;
            rows: depends-rows;
            counts-text: depends-counts;
        }
        Text {
            text: "Required by";
            font-weight: 700;
        }
        SelectionList {
            is-multi: false;
            show-filter: false;
            rows: required-rows;
            counts-text: required-counts;
        }
        HorizontalLayout {
            Button {
                text: "Close";
                primary: true;
                clicked => { cancelled(); }
            }
        }
    }
}
