// Odoo Vite Slint shell (PSS-4): shared sidebar + TabWidget views.
//
// Visual convention (UXS-3, applied in every view; MX-1 Material pass):
// - View title: 16px/700. Card/section header: GroupBox title (style
//   themed). Sub-group label (no card): 14px/700. Body: default size.
// - Dim/secondary text: gray. Errors: red + "⚠" prefix. Warnings: orange.
// - Destructive confirms: red "⚠" heading (std Button has no role).
// - Sections live in GroupBox cards (Overview pilots it); one primary
//   (filled) action per row at most.
// One file per view (beta codegen rule); AppWindow only forwards root
// props/callbacks into embedded components.
import { Button, HorizontalBox, Spinner, TabWidget, VerticalBox } from "std-widgets.slint";
import { Row, SelectionList } from "selection_list.slint";
import { OverviewView } from "overview.slint";
import { DatabasesView, SchedRow } from "databases.slint";
import { ModulesView } from "modules.slint";
import { ConfigurationView } from "configuration.slint";
import { LogsView } from "logs.slint";
import { DevToolsView } from "devtools.slint";

export component AppWindow inherits Window {
    title: app-title;
    min-width: 800px;
    min-height: 500px;
    preferred-width: 1000px;
    preferred-height: 640px;

    in-out property<string> app-title: "Odoo Vite (Slint)";
    in-out property<int> tab-index: 0;
    in-out property<[Row]> sidebar-rows;
    in-out property<string> sidebar-counts: "";
    in-out property<string> sidebar-selected: "";
    in-out property<string> sidebar-filter: "";
    in-out property<string> sidebar-empty: "";
    in-out property<string> status-line: "Ready";

    in-out property<string> ov-name: "";
    in-out property<string> ov-version: "";
    in-out property<string> ov-port: "";
    in-out property<string> ov-path: "";
    in-out property<string> ov-path-full: "";
    in-out property<string> ov-primary: "";
    in-out property<string> ov-dbuser: "";
    in-out property<string> ov-status: "";
    in-out property<bool> is-running: false;
    in-out property<string> ent-text: "";
    in-out property<bool> ent-warn: false;
    in-out property<string> toast-message: "";
    in-out property<bool> toast-showing: false;
    in-out property<string> toast-kind: "info";

    in-out property<bool> db-has-instance: false;
    in-out property<bool> db-busy: false;
    in-out property<[string]> db-names;
    in-out property<string> db-picked: "";
    in-out property<string> db-manual: "";
    in-out property<int> db-row: -1;
    in-out property<[SchedRow]> sched-rows;
    in-out property<int> sched-row: -1;
    in-out property<string> sched-empty: "";
    in-out property<string> server-note: "";
    in-out property<[[StandardListViewItem]]> db-table;

    in-out property<bool> mod-has-instance: false;
    in-out property<string> mod-db: "";
    in-out property<string> mod-search: "";
    in-out property<[string]> mod-filters;
    in-out property<int> mod-filter-idx: 0;
    in-out property<[Row]> mod-rows;
    in-out property<string> mod-counts: "";
    in-out property<string> mod-selected: "";
    in-out property<bool> mod-has-checked: false;
    in-out property<string> mod-empty: "No modules loaded — select an instance with a primary database, then press Refresh.";
    in-out property<bool> mod-busy: false;

    in-out property<bool> conf-has-instance: false;
    in-out property<string> conf-path: "";
    in-out property<[string]> conf-lines;
    in-out property<string> conf-db-host: "";
    in-out property<string> conf-db-port: "";
    in-out property<string> conf-db-user: "";
    in-out property<string> conf-xmlrpc-port: "";
    in-out property<string> conf-logfile: "";
    in-out property<string> conf-addons: "";
    in-out property<string> conf-raw-key: "";
    in-out property<string> conf-raw-value: "";
    in-out property<string> conf-notice: "";
    in-out property<bool> conf-has-backup: false;
    in-out property<string> conf-backup-label: "";
    in-out property<string> conf-description: "";
    in-out property<int> conf-workers: 0;
    in-out property<[string]> conf-log-levels;
    in-out property<int> conf-log-idx: 0;
    in-out property<string> conf-python: "";
    in-out property<string> conf-py-error: "";

    in-out property<bool> log-has-instance: false;
    in-out property<bool> log-follow: true;
    in-out property<string> log-note: "";
    in-out property<string> log-search: "";
    in-out property<[string]> log-levels;
    in-out property<int> log-level-idx: 0;
    in-out property<string> log-search-status: "";
    in-out property<[string]> log-search-lines;
    in-out property<[string]> log-doctor-lines;
    in-out property<bool> log-doctor-visible: false;
    in-out property<[string]> log-tail-lines;
    in-out property<string> log-slow-status: "";
    in-out property<[string]> log-slow-lines;
    in-out property<[string]> log-profile-durs;
    in-out property<int> log-profile-idx: 1;

    in-out property<bool> dev-has-instance: false;
    in-out property<string> dev-rpc-user: "";
    in-out property<string> dev-rpc-pass: "";
    in-out property<bool> dev-rpc-remember: false;
    in-out property<string> dev-rpc-status: "Not connected.";
    in-out property<[Row]> dev-model-rows;
    in-out property<string> dev-model-counts: "";
    in-out property<string> dev-model-selected: "";
    in-out property<string> dev-models-empty: "Connect to an instance to inspect models.";
    in-out property<string> dev-meta: "";
    in-out property<string> dev-dom-field: "";
    in-out property<[string]> dev-dom-ops;
    in-out property<int> dev-dom-op-idx: 0;
    in-out property<string> dev-dom-value: "";
    in-out property<[Row]> dev-rec-rows;
    in-out property<string> dev-rec-counts: "";
    in-out property<string> dev-rec-selected: "";
    in-out property<string> dev-rec-empty: "No query yet — search above.";
    in-out property<string> dev-rec-page: "No query yet.";
    in-out property<[string]> dev-cron-lines;
    in-out property<string> dev-cron-empty: "No cron jobs loaded — press Refresh.";
    in-out property<string> dev-shell-status: "Shell not running.";
    in-out property<bool> dev-shell-running: false;
    in-out property<[string]> dev-shell-lines;
    in-out property<string> dev-shell-in: "";
    in-out property<string> dev-test-module: "";
    in-out property<string> dev-test-db: "";
    in-out property<bool> dev-busy: false;

    callback request-refresh();
    // NOTE Slint 1.18: callback args are type-only, no names.
    callback sidebar-picked(string);
    callback wiz-action(string);
    callback sidebar-filter-changed(string);
    callback sys-action(string);
    callback ov-start();
    callback ov-stop();
    callback ov-restart();
    callback ov-remove();
    callback ov-clone();
    callback ov-export();
    callback db-action(string);
    callback sched-action(string);
    callback sched-picked(int);
    callback mod-action(string);
    callback mod-search-changed(string);
    callback mod-filter-changed(int);
    callback mod-toggled(string);
    callback mod-picked(string);
    callback conf-action(string);
    callback log-action(string);
    callback dev-action(string);
    callback dev-models-picked(string);
    callback dev-rec-picked(string);

    HorizontalBox {
        VerticalBox {
            width: 260px;
            HorizontalLayout {
                Text {
                    text: "Instances";
                    font-size: 18px;
                    font-weight: 700;
                }
                Button {
                    text: "New…";
                    clicked => { wiz-action("new"); }
                }
                Button {
                    text: "Adopt…";
                    clicked => { wiz-action("adopt"); }
                }
            }
            SelectionList {
                is-multi: false;
                show-filter: true;
                rows: sidebar-rows;
                filter-text <=> sidebar-filter;
                counts-text: sidebar-counts;
                selected-id: sidebar-selected;
                row-picked(id) => { sidebar-picked(id); }
                filter-changed(text) => { sidebar-filter-changed(text); }
            }
            Text {
                visible: sidebar-empty != "";
                text: sidebar-empty;
                color: gray;
                wrap: word-wrap;
            }
            HorizontalLayout {
                Button {
                    text: "Preferences";
                    clicked => { sys-action("preferences"); }
                }
                Button {
                    text: "Import…";
                    clicked => { sys-action("import"); }
                }
            }
            Button {
                text: "About Slint";
                clicked => { sys-action("about"); }
            }
        }
        VerticalBox {
            TabWidget {
                current-index <=> tab-index;                Tab {
                    title: "Overview";
                    OverviewView {
                        ov-name: ov-name;
                        ov-version: ov-version;
                        ov-port: ov-port;
                        ov-path: ov-path;
                        ov-path-full: ov-path-full;
                        ov-primary: ov-primary;
                        ov-dbuser: ov-dbuser;
                        ov-status: ov-status;
                        is-running: is-running;
                        ent-text: ent-text;
                        ent-warn: ent-warn;
                        ov-start => { ov-start(); }
                        ov-stop => { ov-stop(); }
                        ov-restart => { ov-restart(); }
                        ov-remove => { ov-remove(); }
                        ov-clone => { ov-clone(); }
                        ov-export => { ov-export(); }
                    }
                }
                Tab {
                    title: "Databases";
                    DatabasesView {
                        has-instance: db-has-instance;
                        db-busy: db-busy;
                        db-names: db-names;
                        db-picked <=> db-picked;
                        db-manual <=> db-manual;
                        table-rows: db-table;
                        table-row <=> db-row;
                        sched-rows: sched-rows;
                        sched-row <=> sched-row;
                        sched-empty: sched-empty;
                        server-note: server-note;
                        db-action(action) => { db-action(action); }
                        sched-action(action) => { sched-action(action); }
                        sched-picked(idx) => { sched-picked(idx); }
                    }
                }
                Tab {
                    title: "Modules";
                    ModulesView {
                        has-instance: mod-has-instance;
                        mod-db <=> mod-db;
                        mod-search <=> mod-search;
                        mod-filters: mod-filters;
                        mod-filter-idx <=> mod-filter-idx;
                        mod-rows: mod-rows;
                        mod-counts: mod-counts;
                        mod-selected: mod-selected;
                        mod-has-checked: mod-has-checked;
                        mod-empty: mod-empty;
                        mod-busy: mod-busy;
                        mod-action(action) => { mod-action(action); }
                        mod-search-changed(text) => { mod-search-changed(text); }
                        mod-filter-changed(idx) => { mod-filter-changed(idx); }
                        mod-toggled(id) => { mod-toggled(id); }
                        mod-picked(id) => { mod-picked(id); }
                    }
                }
                Tab {
                    title: "Configuration";
                    ConfigurationView {
                        has-instance: conf-has-instance;
                        conf-path: conf-path;
                        conf-lines: conf-lines;
                        conf-db-host <=> conf-db-host;
                        conf-db-port <=> conf-db-port;
                        conf-db-user <=> conf-db-user;
                        conf-xmlrpc-port <=> conf-xmlrpc-port;
                        conf-logfile <=> conf-logfile;
                        conf-addons: conf-addons;
                        conf-raw-key <=> conf-raw-key;
                        conf-raw-value <=> conf-raw-value;
                        conf-notice: conf-notice;
                        conf-has-backup: conf-has-backup;
                        conf-backup-label: conf-backup-label;
                        conf-description <=> conf-description;
                        conf-workers <=> conf-workers;
                        conf-log-levels: conf-log-levels;
                        conf-log-idx <=> conf-log-idx;
                        conf-python <=> conf-python;
                        conf-py-error: conf-py-error;
                        conf-action(action) => { conf-action(action); }
                    }
                }
                Tab {
                    title: "Logs";
                    LogsView {
                        has-instance: log-has-instance;
                        log-follow <=> log-follow;
                        log-note: log-note;
                        log-search <=> log-search;
                        log-levels: log-levels;
                        log-level-idx <=> log-level-idx;
                        log-search-status: log-search-status;
                        log-search-lines: log-search-lines;
                        log-doctor-lines: log-doctor-lines;
                        log-doctor-visible: log-doctor-visible;
                        log-tail-lines: log-tail-lines;
                        log-slow-status: log-slow-status;
                        log-slow-lines: log-slow-lines;
                        log-profile-durs: log-profile-durs;
                        log-profile-idx <=> log-profile-idx;
                        log-action(action) => { log-action(action); }
                    }
                }
                Tab {
                    title: "DevTools";
                    DevToolsView {
                        has-instance: dev-has-instance;
                        dev-rpc-user <=> dev-rpc-user;
                        dev-rpc-pass <=> dev-rpc-pass;
                        dev-rpc-remember <=> dev-rpc-remember;
                        dev-rpc-status: dev-rpc-status;
                        dev-model-rows: dev-model-rows;
                        dev-model-counts: dev-model-counts;
                        dev-model-selected: dev-model-selected;
                        dev-models-empty: dev-models-empty;
                        dev-meta: dev-meta;
                        dev-dom-field <=> dev-dom-field;
                        dev-dom-ops: dev-dom-ops;
                        dev-dom-op-idx <=> dev-dom-op-idx;
                        dev-dom-value <=> dev-dom-value;
                        dev-rec-rows: dev-rec-rows;
                        dev-rec-counts: dev-rec-counts;
                        dev-rec-selected: dev-rec-selected;
                        dev-rec-empty: dev-rec-empty;
                        dev-rec-page: dev-rec-page;
                        dev-cron-lines: dev-cron-lines;
                        dev-cron-empty: dev-cron-empty;
                        dev-shell-status: dev-shell-status;
                        dev-shell-running: dev-shell-running;
                        dev-shell-lines: dev-shell-lines;
                        dev-shell-in <=> dev-shell-in;
                        dev-test-module <=> dev-test-module;
                        dev-test-db <=> dev-test-db;
                        dev-busy: dev-busy;
                        dev-action(action) => { dev-action(action); }
                        dev-models-picked(id) => { dev-models-picked(id); }
                        dev-rec-picked(id) => { dev-rec-picked(id); }
                    }
                }
            }
            HorizontalBox {
                Button {
                    text: "Refresh";
                    clicked => { request-refresh(); }
                }
                Spinner {
                    visible: mod-busy || db-busy || dev-busy;
                }
                Text {
                    text: mod-busy || db-busy || dev-busy ? "Working…" : status-line;
                    color: gray;
                    wrap: word-wrap;
                }
            }
            Rectangle {
                visible: toast-showing;
                background: #323232;
                border-radius: 4px;
                HorizontalLayout {
                    padding: 8px;
                    Text {
                        text: toast-kind == "error" ? "⚠ " + toast-message : toast-message;
                        color: toast-kind == "error" ? #ffb4ab : white;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
