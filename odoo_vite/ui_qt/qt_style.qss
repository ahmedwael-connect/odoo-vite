/* Odoo Vite Qt tokens (PSQ-1.4) — same design decisions as ui/style.css.
 * SPACING SCALE (px): 4 / 8 / 12 / 16 / 24 / 32 — same meanings, see
 * docs/design-system.md. QSS has no variables: concrete values below are
 * drawn from the scale; do not invent others.
 *
 * COLORS: QSS cannot read libadwaita named colors. palette() roles are
 * used where they are reliable (highlight, window, base, text); but
 * palette(mid) is NOT reliable — bare environments resolve it to white,
 * rendering every dim/border element invisible (caught by the human pass).
 * Dim + borders therefore use fixed neutral grays (readable on light AND
 * dark), same documented-exception principle as the GTK build's
 * .status-stopped gray. System dark mode: qt_style_dark.qss, chosen via
 * ui_qt/theme.py (XDG portal) — same tokens, flipped surfaces.
 *   success #2ec27e | warning #e5a50a | error #e01b24 | neutral #9a9996
 *
 * FONTS: no pixel sizes — default font; headings via font-weight only.
 */

QMainWindow {
    background: palette(window);
}

QToolBar {
    spacing: 8px;
    padding: 4px 8px;
    background: palette(window);
    border: none;
    border-bottom: 1px solid #cccccc;
}

QToolBar QLabel {
    font-weight: bold;
}

QSplitter::handle {
    background: #cccccc;
    width: 1px;
}

QListWidget {
    padding: 8px;
    background: palette(base);
    border: none;
    border-right: 1px solid #cccccc;
}

QListWidget::item {
    padding: 8px;
    border-radius: 8px;
}

QListWidget::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
    font-weight: bold;
}

QStackedWidget {
    background: palette(window);
}

QLabel[class="heading"] {
    font-weight: bold;
}

QLabel[class="dim"] {
    color: #888888;
}

QLabel[class="error"] {
    color: #e01b24;
}

QLabel[class="warning"] {
    color: #e5a50a;
}

QLabel[class="success"] {
    color: #2ec27e;
    font-weight: bold;
}

/* Selected-row treatment mirrors GTK .discover-picked: bold + accent,
 * always visible, never hover-only. */
QLabel[class="picked"] {
    font-weight: bold;
    color: palette(highlight);
}
