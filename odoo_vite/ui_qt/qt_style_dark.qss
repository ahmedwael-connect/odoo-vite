/* Odoo Vite Qt tokens — DARK variant (PSQ-10). Same scale, same class
 * contract as qt_style.qss; only surfaces flip. Dim/border grays are the
 * same fixed values (readable on both), per the human-pass finding that
 * palette(mid) cannot be trusted. Applied when the desktop prefers dark
 * (XDG portal); live-switches via ThemeMonitor.
 */

QMainWindow {
    background: #2d2d2d;
}

QWidget {
    background: #2d2d2d;
    color: #e8e8e8;
}

QToolBar {
    spacing: 8px;
    padding: 4px 8px;
    background: #2d2d2d;
    border: none;
    border-bottom: 1px solid #444444;
}

QToolBar QLabel {
    font-weight: bold;
    color: #e8e8e8;
}

QSplitter::handle {
    background: #444444;
    width: 1px;
}

QListWidget, QListView {
    padding: 8px;
    background: #353535;
    color: #e8e8e8;
    border: none;
    border-right: 1px solid #444444;
}

QListWidget::item {
    padding: 8px;
    border-radius: 8px;
}

QListWidget::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
    font-weight: bold;
}

QTabWidget::pane {
    background: #2d2d2d;
    border: none;
}

QTabBar::tab {
    background: #353535;
    color: #e8e8e8;
    padding: 6px 12px;
}

QTabBar::tab:selected {
    background: #2d2d2d;
    font-weight: bold;
}

QLabel[class="heading"] {
    font-weight: bold;
    color: #ffffff;
}

QLabel[class="dim"] {
    color: #9a9996;
}

QLabel[class="error"] {
    color: #f66151;
}

QLabel[class="warning"] {
    color: #e5a50a;
}

QLabel[class="success"] {
    color: #2ec27e;
    font-weight: bold;
}

QLabel[class="picked"] {
    font-weight: bold;
    color: palette(highlight);
}

QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background: #353535;
    color: #e8e8e8;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 4px 8px;
}

QPushButton {
    background: #353535;
    color: #e8e8e8;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:disabled {
    color: #777777;
}

QPushButton[role="destructive"] {
    color: #f66151;
}

QCheckBox, QRadioButton {
    color: #e8e8e8;
    spacing: 8px;
}

QToolTip {
    background: #353535;
    color: #e8e8e8;
    border: 1px solid #555555;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #777777;
}
